# Server port
PORT=4000

# PostgreSQL connection string
# Local (Docker Compose): postgres://postgres:postgres@localhost:5432/carehub
DATABASE_URL=postgres://postgres:postgres@localhost:5432/carehub

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed CORS origins (the deployed frontend URL)
CORS_ORIGIN=http://localhost:8080

# Run SQL migrations automatically on server start (recommended in production)
RUN_MIGRATIONS=true

# Optional Redis URL for the report rate limiter store (falls back to in-memory)
REDIS_URL=